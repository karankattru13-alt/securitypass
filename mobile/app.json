{
  "expo": {
    "name": "SocietyPass",
    "slug": "societypass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "societypass",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.societypass.mobile"
    },
    "android": {
      "package": "in.societypass.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-image-picker"
    ],
    "extra": {}
  }
}
