# Copy to .env to override defaults. All vars must be prefixed EXPO_PUBLIC_ to be
# visible to the app at build time.

# Use the built-in in-memory mock backend (default). Set to "false" to talk to a
# real API server at EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_USE_MOCK=true

# Real backend base URL (only used when EXPO_PUBLIC_USE_MOCK=false)
EXPO_PUBLIC_API_URL=http://localhost:8000/api
