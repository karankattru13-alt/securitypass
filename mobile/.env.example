# Copy to .env to override defaults. All vars must be prefixed EXPO_PUBLIC_ to be
# visible to the app at build time.

# Use the built-in in-memory mock backend (default). Set to "false" to talk to a
# real API server at EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_USE_MOCK=true

# Real backend base URL (only used when EXPO_PUBLIC_USE_MOCK=false)
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# WhatsApp visitor-request alerts
# Country code prepended to a 10-digit resident phone (India = 91)
EXPO_PUBLIC_WA_COUNTRY_CODE=91
# Base URL for the "approve / deny" link in the WhatsApp message.
# Default (societypass://) opens the installed app. Point it at your hosted web
# build for a link that also opens in a browser, e.g. https://app.example.com
EXPO_PUBLIC_APP_URL=societypass://
